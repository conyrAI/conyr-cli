{
  "name": "conyr-cli",
  "version": "1.1.0",
  "description": "Solana coin checks from Conyr's API: coordinated wallet bundles on a coin and the kinds of wallets buying it, free with no signup. Any /v1 route with a key.",
  "keywords": [
    "solana",
    "conyr",
    "cli",
    "token",
    "bundles",
    "wallets",
    "onchain",
    "crypto",
    "api",
    "ai-agent"
  ],
  "homepage": "https://conyr.ai/api?utm_source=npm&utm_medium=package&utm_content=conyr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conyrAI/conyr-cli.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "conyr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "npm run build && node tools/check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
